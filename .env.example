# Copy to .env (root) for local dev. Real cluster injects via SealedSecrets.
# This file is a TEMPLATE — fill in real values for your dev.

NODE_ENV=development

# postgres
DATABASE_URL=postgresql://app:app@localhost:5432/app

# redis
REDIS_URL=redis://localhost:6379

# rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# auth (only required by auth-backend)
JWKS_URL=http://localhost:3001/.well-known/jwks.json
# JWT_PRIVATE_KEY=

# frontend (BFF API base → backend)
API_BASE=http://localhost:3001

# public env (NEXT_PUBLIC_*)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
