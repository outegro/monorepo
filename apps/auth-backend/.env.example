NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://app:app@localhost:5432/auth
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# ES256 P-256 private key (PKCS8 PEM). Generate for local dev:
#   openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt
# Paste as a single line with \n, or load via your shell. Required — boot fails without it.
JWT_PRIVATE_KEY=
JWT_ISSUER=https://id.outegro.com
JWT_AUDIENCE=outegro
ACCESS_TTL=300
REFRESH_TTL=2592000
CODE_TTL=600
PUBLIC_ORIGIN=https://id.outegro.com
COOKIE_DOMAIN=.outegro.com
REFRESH_COOKIE=outegro_refresh
# Optional until their features land:
INTERNAL_API_KEY=
ADMIN_API_KEY=
