// Prisma 7 schema — NO `url` here (driver adapters; see prisma.config.ts + PrismaService).
// edu owns its own DB. Explicit queries (no nested include / lazy fetches — CLAUDE.md rule).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A course (e.g. "Korean for beginners"). Chapters unlock progressively.
model Course {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  description String?
  level       String? // beginner | intermediate | ...
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  chapters Chapter[]

  @@map("courses")
}

/// A lesson within a course. `material` is markdown; `vocab` / `mockTest` are JSON.
/// Admin-editable on the site. `index` drives progressive unlocking.
model Chapter {
  id             String   @id @default(uuid()) @db.Uuid
  courseId       String   @map("course_id") @db.Uuid
  index          Int
  title          String
  material       String // markdown lesson content
  vocab          Json     @default("[]") // [{ ko, ru, romanization }]
  mockTest       Json     @map("mock_test") @default("[]") // [{ question, options[], answerIndex }]
  homeworkPrompt String?  @map("homework_prompt")
  recordingUrl   String?  @map("recording_url")
  published      Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, index], name: "chapter_course_index_uq")
  @@index([courseId])
  @@map("chapters")
}

/// Per-user progress in a course. `unlockedIndex` = highest chapter index they can open.
model Enrollment {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  unlockedIndex Int      @default(0) @map("unlocked_index")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, courseId], name: "enrollment_user_course_uq")
  @@map("enrollments")
}

/// A homework attempt + the AI grade/feedback (JSON: score, corrections, feedback).
model HomeworkSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  chapterId String   @map("chapter_id") @db.Uuid
  answer    String
  score     Int?
  feedback  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, chapterId])
  @@map("homework_submissions")
}

/// User's personal vocabulary (Quizlet-like). Words saved from chapters or added by hand.
model VocabEntry {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  ko           String
  ru           String
  romanization String?
  chapterId    String?  @map("chapter_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, ko], name: "vocab_user_ko_uq")
  @@index([userId])
  @@map("vocab_entries")
}

/// Transactional outbox — events (notifications) published to RabbitMQ by the relay.
model OutboxEvent {
  id          String    @id @db.Uuid
  exchange    String
  routingKey  String    @map("routing_key")
  payload     Json
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publishedAt])
  @@map("outbox")
}
