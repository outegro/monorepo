// Prisma 7 schema — NO `url` here (driver adapters, see prisma.config.ts + PrismaService).
// Generator points to a `src/generated` folder that's gitignored; build runs `prisma generate`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Durable history of AI tagline jobs. Status walks pending → done | failed.
// (Throwaway demo: Postgres store + Redis cache/status + RabbitMQ async worker + AI.)
enum TaglineJobStatus {
  pending
  done
  failed
}

model TaglineJob {
  id          String           @id @default(cuid())
  prompt      String
  status      TaglineJobStatus @default(pending)
  taglines    String[]
  error       String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?

  @@index([status])
  @@map("tagline_jobs")
}
