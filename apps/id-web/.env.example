# id-web BFF — server-only. The browser never sees these.
NODE_ENV=development
# auth-backend base. In-cluster: http://auth-backend:80 . Local dev: the Nest port.
AUTH_API_BASE=http://localhost:3002
# Public origin of id-web (CSRF same-origin check, prod only).
PUBLIC_ORIGIN=https://id.outegro.com
# Refresh cookie domain (shared across *.outegro.com). Leave empty in dev (host-only).
COOKIE_DOMAIN=
REFRESH_COOKIE=outegro_refresh
