NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://notifications-backend:notifications-backend@localhost:5432/notifications-backend
RABBITMQ_URL=amqp://outegro:outegro@localhost:5672
# Optional in dev — without RESEND_API_KEY the EmailAdapter logs instead of sending.
RESEND_API_KEY=
RESEND_FROM=Outegro <noreply@outegro.com>
# Telegram (optional until linking flow) — bot token + webhook secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Shared service-to-service secret (same value in auth-backend).
INTERNAL_API_KEY=
