// Prisma 7 schema — NO `url` here (driver adapters; see prisma.config.ts + PrismaService).
// Generator → gitignored src/generated; build runs `prisma generate`.
// notifications owns its own DB (database-per-service). userId is a foreign *value*
// from auth, NOT an FK — services never share tables.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Idempotent delivery ledger — one row per (event, channel). The consumer skips a
/// (event, channel) that already succeeded, so redeliveries never double-send.
model DeliveryLog {
  id                String   @id @default(uuid()) @db.Uuid
  eventId           String   @map("event_id")
  channel           String
  userId            String   @map("user_id")
  template          String
  status            String // sent | failed | skipped
  providerMessageId String?  @map("provider_message_id")
  error             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([eventId, channel], name: "delivery_event_channel_uq")
  @@index([userId])
  @@map("delivery_log")
}

/// Per-user opt-out matrix (type × channel). Mandatory templates ignore this.
/// Absence of a row = enabled (default-on).
model Preference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  type      String
  channel   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, type, channel], name: "pref_user_type_channel_uq")
  @@map("preferences")
}

/// Telegram chat linking, set via the deep-link flow. One chat per user.
model TelegramLink {
  userId    String   @id @map("user_id")
  chatId    String   @map("chat_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([chatId])
  @@map("telegram_links")
}
