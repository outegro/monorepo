// trips-backend schema — a catalogue of places harvested from Instagram Reels, built for a
// specific trip. The pipeline is: a reel URL (+ an optional free-text note) comes in, the LLM
// turns the note into a search query, Kakao Local returns candidates, and a HUMAN confirms
// which candidate is the real place. Nothing reaches `places` without that confirmation —
// auto-resolution is wrong often enough that unreviewed rows would poison the trip plan.
//
// Two signals feed extraction: the reel's own caption, read at ingest by yt-dlp, and an
// optional note the submitter typed. The caption is usually the better of the two. Instagram's
// HTML surfaces are login-walled (og:meta, /embed/captioned/, oEmbed all return nothing
// anonymously — checked 2026-07-27), which is why this goes through yt-dlp rather than a
// hand-rolled scrape; when even that fails, the note is what is left.
//
// All rows scoped by `userId` (auth `sub`); trips owns its own database, no cross-service FK.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlaceKind {
  // A single point you go to: a restaurant, a cafe, a viewpoint.
  SPOT
  // Something you walk along — a hiking trail, a market street, a riverside stretch. The
  // difference is not cosmetic: for a route the coordinate you NAVIGATE to is the trailhead,
  // not the destination. Kakao returns 제비봉 (the peak) and 제비봉탐방지원센터 (the visitor
  // centre at the bottom) as separate places; pinning the peak and deep-linking to it sends
  // you to a mountaintop with no road.
  ROUTE

  @@map("place_kind")
}

enum ReelStatus {
  // Just submitted; nothing has looked at it yet.
  PENDING
  // LLM produced a search query + guessed category from the note.
  EXTRACTED
  // Kakao returned candidates and a human needs to pick one.
  NEEDS_REVIEW
  // A human picked a candidate → a Place row exists.
  CONFIRMED
  // A human decided this reel is not worth a place (duplicate, not in Korea, junk).
  SKIPPED
  // Extraction or search failed; `error` says why. Retryable.
  FAILED

  @@map("reel_status")
}

// One submitted reel. `shortcode` is parsed out of the URL and is what we dedupe on —
// the same reel shared twice (by both of us) must not become two places.
model Reel {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  url       String
  shortcode String
  /// Free-text hint typed by whoever submitted it: place name, district, "카페 in 성수",
  /// anything.
  note      String?
  /// The reel's own caption, read by yt-dlp at ingest. Usually far richer than the note —
  /// Korean reels tend to name the place outright — so extraction prefers it and falls back
  /// to `note`. Null when the post is private, deleted, or yt-dlp was rate-limited.
  caption   String?
  uploader  String?
  thumbnail String?
  status    ReelStatus @default(PENDING)
  /// LLM output: { query, categoryGroup, district, priceHint, keywords[] }. Kept raw so a
  /// prompt change can be re-run over old rows without a migration.
  extracted Json?
  /// Kakao Local hits offered to the reviewer, in rank order. Cleared after confirmation.
  candidates Json?
  error     String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Many reels → one place. Two people sending three reels about the same restaurant is the
  /// normal case, not an edge case, so the place is the entity and reels hang off it.
  placeId String? @map("place_id") @db.Uuid
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  // Dedupe per user, not globally — two people may legitimately track the same reel.
  @@unique([userId, shortcode])
  // The review queue reads exactly this.
  @@index([userId, status])
  @@map("reels")
}

// A confirmed, real place with coordinates. This is what the trip is actually planned from.
model Place {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Every reel that pointed here. Confirming a second reel onto an already-saved place
  /// attaches it rather than creating a duplicate pin on the map.
  reels Reel[]

  /// Kakao's own place id — lets us re-open the place in KakaoMap and dedupe across reels.
  kakaoId       String  @map("kakao_id")
  name          String
  /// Kakao category group code: FD6 food, CE7 cafe, AT4 attraction, CT1 culture, …
  categoryGroup String? @map("category_group")
  /// Kakao's full category path, e.g. "음식점 > 카페 > 커피전문점".
  categoryName  String? @map("category_name")
  address       String?
  roadAddress   String? @map("road_address")
  phone         String?
  /// Kakao place page; the map.kakao.com/link deep link for navigation is built from lat/lng.
  kakaoUrl      String? @map("kakao_url")

  kind PlaceKind @default(SPOT)

  /// WGS84, and always THE POINT YOU TRAVEL TO — for a ROUTE that is the trailhead, not the
  /// summit. Every deep link and every distance calculation uses this, so it has to be the
  /// reachable end of the thing.
  ///
  /// Plain floats on purpose: at ~100 places PostGIS would be ceremony, and the only geometry
  /// we do is "group things that are near each other".
  lat Float
  lng Float

  /// Ordered stops for a ROUTE: [{ name, lat, lng, role: "start"|"via"|"end" }]. JSON rather
  /// than a table — it is read and written whole, never queried across, and a trip has a
  /// handful of routes at most. `lat`/`lng` above duplicate the "start" entry so that SPOT and
  /// ROUTE behave identically everywhere that just needs a pin.
  waypoints Json?

  /// Rough walking time in minutes and length in km, when the reel says so. Free-form sources
  /// disagree wildly, so these are hints for planning a day, not a promise.
  durationMin Int?   @map("duration_min")
  distanceKm  Float? @map("distance_km")

  /// Free-text price hint from the note ("15,000원 per person"), kept as text deliberately —
  /// reels quote prices too inconsistently to model as a number.
  priceNote String?  @map("price_note")
  tags      String[] @default([])
  // NB: a place deliberately carries NO day of its own. Scheduling happens by attaching it to
  // a TripDay (see TripItem.placeId) — two independent notions of "which day" would drift the
  // moment one of them was edited, and the trip side is the one with the times on it.

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// The dedupe key. Kakao's place id is stable, so "same place" is decided by Kakao rather
  /// than by comparing names — 스타벅스 exists a hundred times over and name matching would
  /// merge places that merely share a brand.
  tripItems TripItem[]

  @@unique([userId, kakaoId])
  @@index([userId, categoryGroup])
  @@map("places")
}

// ─────────────────────────────────────────────────────────── the trip itself
//
// The catalogue above answers "where could we go". This half answers "what are we doing on
// Tuesday", and it is the part that gets opened on a phone in Seoul. The itinerary is authored
// outside the app (a real plan existed before this service did) and imported; the app's job is
// to show it, let a team choose between alternatives, and hang saved places off it.

enum TripRole {
  OWNER
  MEMBER

  @@map("trip_role")
}

model Trip {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  /// Where we sleep — shown at the top of every day so "how do I get home" is one tap away.
  baseName    String? @map("base_name")
  baseAddress String? @map("base_address")
  baseLat     Float?  @map("base_lat")
  baseLng     Float?  @map("base_lng")

  /// Short human-typeable code. This is a two-person trip; a full invite-token flow would be
  /// more ceremony than the thing it protects, and the trip contains no secrets.
  inviteCode String @unique @map("invite_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members TripMember[]
  days    TripDay[]

  @@map("trips")
}

model TripMember {
  tripId   String   @map("trip_id") @db.Uuid
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id") @db.Uuid
  /// Denormalised so a day view can label a vote without calling auth for every row.
  label    String?
  role     TripRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  votes Vote[]

  @@id([tripId, userId])
  @@map("trip_members")
}

model TripDay {
  id     String   @id @default(uuid()) @db.Uuid
  tripId String   @map("trip_id") @db.Uuid
  trip   Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  /// "Arrival + Hongdae", "Hallasan + Jungmun Beach" — the day's headline from the itinerary.
  title  String?
  /// Seoul / Jeju / Yangyang. Drives the map's starting viewport.
  city   String?

  items TripItem[]

  @@unique([tripId, date])
  @@map("trip_days")
}

model TripItem {
  id     String  @id @default(uuid()) @db.Uuid
  dayId  String  @map("day_id") @db.Uuid
  day    TripDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  /// Local wall-clock strings ("08:25", "10:15"), not timestamps. The trip spans one timezone,
  /// the source is a printed plan, and half the entries are open-ended ("20:00 onwards") —
  /// modelling these as instants would invent a precision the plan does not have.
  startsAt String? @map("starts_at")
  endsAt   String? @map("ends_at")

  title   String
  /// Korean name, kept separate: it is what you show a taxi driver.
  titleKr String? @map("title_kr")
  /// Route, notes, what to do — free text straight from the itinerary.
  details String?

  address   String? 
  addressKr String? @map("address_kr")
  lat       Float?
  lng       Float?

  /// "₩17,000 per person", "US$27.05" — text, because the plan quotes them inconsistently.
  cost       String?
  bookingUrl String? @map("booking_url")

  /// Items sharing a group are ALTERNATIVES, not a sequence: the itinerary already works this
  /// way ("NORMAL OPTION" vs "ABSOLUTELY WRECKED OPTION", full vs short Hallasan route). Null
  /// means the item simply happens.
  optionGroup   String? @map("option_group")
  /// Label for the alternative within its group.
  optionLabel   String? @map("option_label")
  /// Set once the team settles on one. Advisory — nothing enforces a single winner, because on
  /// the day you sometimes do neither.
  chosen        Boolean @default(false)

  /// A place saved from a reel, slotted into the plan.
  placeId String? @map("place_id") @db.Uuid
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  /// Manual ordering inside a day, since not everything has a start time.
  position Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  votes Vote[]

  @@index([dayId, position])
  @@index([optionGroup])
  @@map("trip_items")
}

/// Who wants what. The whole point of the team: on an alternative you can see, before the day
/// arrives, that one of you wants the full Hallasan route and the other does not.
model Vote {
  itemId String   @map("item_id") @db.Uuid
  item   TripItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tripId String   @map("trip_id") @db.Uuid
  userId String   @map("user_id") @db.Uuid
  member TripMember @relation(fields: [tripId, userId], references: [tripId, userId], onDelete: Cascade)

  /// -1 rather than a plain like: "I would skip this" is as useful to see as "I want this".
  value     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([itemId, userId])
  @@index([tripId, userId])
  @@map("votes")
}
