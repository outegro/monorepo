# syntax=docker/dockerfile:1
# Shared image for any NestJS backend. Build with:
#   docker build --build-arg APP=auth-backend -f infra/Dockerfile.nest .
#
# Prisma 7 has no native query engine → nothing engine-shaped to copy into the runner.
# tini as PID 1 so SIGCHLD/SIGTERM work correctly.
ARG NODE_IMAGE=node:24-alpine

FROM ${NODE_IMAGE} AS build
ARG APP
RUN apk add --no-cache libc6-compat
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
# `prisma generate` (inside the app's build) only needs DATABASE_URL to be present
# — it reads the schema, never connects. The real URL comes from the sealed secret
# at runtime; the migration Job (prisma migrate deploy) still fails loud if it's
# missing there. This placeholder lives in the build stage only — not the runner.
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
# Build via turbo so the `db:generate` task (prisma generate) runs once before the
# package build — prevents the concurrent-`prisma generate` race and keeps a single
# source of generation across build/typecheck/test.
RUN pnpm turbo run build --filter "@outegro/${APP}"
# pnpm v10 only deploys "injected" workspaces by default; --legacy restores the
# pre-v10 behavior (resolve workspace:* deps from the monorepo) for the prod prune.
RUN pnpm --filter "@outegro/${APP}" --prod deploy --legacy /out

FROM ${NODE_IMAGE} AS runner
ARG APP
RUN apk add --no-cache tini

# yt-dlp, only for the services that ask for it (currently trips-backend, which reads
# Instagram reel captions). Deliberately opt-in rather than baked into every backend: it
# pulls in Python (~60MB), and a tool whose whole job is fetching arbitrary remote media has
# no business sitting inside auth-backend.
#
# Pinned, not floating. Instagram changes shape often enough that yt-dlp ships weekly, so the
# version is a thing we bump on purpose and can roll back — an unpinned `pip install` would
# make every rebuild a different program.
ARG WITH_YTDLP=0
ARG YTDLP_VERSION=2026.7.4
RUN if [ "$WITH_YTDLP" = "1" ]; then \
      apk add --no-cache python3 py3-pip && \
      pip3 install --no-cache-dir --break-system-packages "yt-dlp==${YTDLP_VERSION}" && \
      yt-dlp --version; \
    fi
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /repo/apps/${APP}/dist ./dist
COPY --from=build /repo/apps/${APP}/src/generated ./dist/generated
COPY --from=build /repo/apps/${APP}/prisma ./prisma
# prisma.config.ts is read by `prisma migrate deploy` (chart PreSync hook) to resolve
# the datasource URL + schema path. Ship it so the same image can run migrations.
COPY --from=build /repo/apps/${APP}/prisma.config.ts ./prisma.config.ts
USER node
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/main.js"]
