# syntax=docker/dockerfile:1
# Shared image for any Next.js frontend (standalone Node server). Build with:
#   docker build --build-arg APP=auth-web -f infra/Dockerfile.next .
#
# tini as PID 1.
ARG NODE_IMAGE=node:24-alpine

FROM ${NODE_IMAGE} AS build
ARG APP
RUN apk add --no-cache libc6-compat
RUN corepack enable
WORKDIR /repo
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm install --frozen-lockfile
RUN pnpm --filter "@outegro/${APP}" build
# git does not track empty directories, so an app with no static assets ships without
# `public/` and the runner-stage COPY below fails the whole build ("public: not found").
# That bit edu-web once (2f65e64) and then budget-web + itmaxxing-web again. Materialising
# the directory here makes the COPY unconditional instead of relying on every new app
# remembering to commit a .gitkeep.
RUN mkdir -p apps/${APP}/public

FROM ${NODE_IMAGE} AS runner
ARG APP
RUN apk add --no-cache tini
ENV APP=${APP}
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
# `output: "standalone"` traces the minimal server + node_modules from the monorepo root.
COPY --from=build /repo/apps/${APP}/.next/standalone ./
COPY --from=build /repo/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build /repo/apps/${APP}/public ./apps/${APP}/public
USER node
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["sh", "-c", "node apps/$APP/server.js"]
